node_modules/

# The tool's own Chrome profile — holds the live Flipkart seller session (cookies, Login
# Data). Never commit this; anyone with the folder is logged in as us.
profile/

# Working images. The folders themselves are kept (via .gitkeep) so the pipeline has
# somewhere to write on a fresh clone; their contents are yours, not the repo's.
images/1-raw/*
images/2-clean/*
images/3-final/*
!images/*/.gitkeep

# Per-product image descriptions are business data, not code. The bundled EXAMPLE stays
# so a new machine has something to copy.
image-meta/*
!image-meta/EXAMPLE-*.json

# The 66-field Flipkart files, for the same reason as image-meta/ above: business data, not code.
# In development the app's workspace IS this folder (gui/main.ts storedWorkspace), so every
# listing anyone builds lands here — and committed, a partner cloning the repo would find Vansh's
# real listings sitting in his own app looking like his. The bundled EXAMPLE stays.
products/*
!products/EXAMPLE-*.json
!products/.gitkeep

# Costed kits (WW-115). Business data like image-meta/ — the reading off one inventory sheet
# plus whoever corrected it. The price list they are costed against DOES ship, in categories/.
inventory/

# A day of orders and who packed it (WW-172). Business data, and payroll data at that — same
# reasoning as inventory/ above, and in development this folder IS the app's workspace. The one
# manifest that IS committed is tests/fixtures/meesho-manifest.pdf, which the parser is tested on.
orders/
