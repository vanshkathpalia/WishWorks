# macOS
.DS_Store

# Secrets. Names live in .env.example and docs/key.md; values never get committed.
.env
.env.*
!.env.example
docs/key.md

node_modules/

# The desktop app's build output: `electron-vite build` writes out/, electron-builder dist/.
out/
dist/

# ---------------------------------------------------------------------------
# This machine's global gitignore (~/.gitignore_global) excludes *.json wholesale.
# That is a sensible default for stray service-account keys, but this project is
# largely MADE of JSON — package.json, package-lock.json, tsconfig.json, the product
# files and the category defaults. Left alone it produces a repo that clones and
# cannot even be installed, and the failure is silent: `git status` simply never
# mentions the missing files.
#
# A repo .gitignore outranks the global one, so re-including them here fixes it.
# Genuinely private JSON is still excluded, by the rules just below and by
# flipkart-autofill/.gitignore (which keeps image-meta/ out).
# ---------------------------------------------------------------------------
!*.json

# ---------------------------------------------------------------------------
# Marketplace exports, and any other data file dropped at the top level.
#
# `flipkart-autofill/.gitignore` already keeps orders/, inventory/, products/ and
# latch/ out, and it is thorough — but a nested .gitignore cannot reach ABOVE its
# own folder, and a report downloaded from Meesho lands wherever the browser put
# it, which is usually right here. Three `Orders_*.csv` sat in a PUBLIC repo that
# way: every sub-order number, packet id, delivery state, and the price each SKU
# actually sold for — which beside categories/materials.json is the exact margin
# on every listing.
#
# So the rule is positional, not by name: a spreadsheet at the root of this repo,
# or of flipkart-autofill/, is data and never code. Fixtures live in
# tests/fixtures/ and are unaffected, as is anything nested like categories/.
# ---------------------------------------------------------------------------
/*.csv
/*.xlsx
/*.xls
/flipkart-autofill/*.csv
/flipkart-autofill/*.xlsx
/flipkart-autofill/*.xls

# Meesho's own blank bulk-upload template is the exception: it is THEIR document, holds no price,
# no GSTIN and no order of ours, and `docs/tracks/notion/MEESHO-FROM-LATCH.md` works from it. It
# survives the rule above only because it is already tracked, and a rule that depends on that is a
# trap — re-add it once and it silently vanishes. Named here so it stays for the right reason.
!Party-Items-*-EXTERNAL-MeeshoTemplate*.xlsx

# And by name as well, so one dropped in a subfolder is still caught.
Orders_*.csv
**/*payment*.csv
**/*settlement*.csv

# Local editor/agent state — machine-specific, not shared.
.claude/settings.local.json

# Never commit credentials, whatever the extension.
*.pem
*.p12
*.key
**/service-account*.json
**/*credentials*.json
